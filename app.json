{
  "expo": {
    "name": "AloeMate",
    "slug": "aloemate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aloemate",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F9F4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.aloemate"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F7F9F4"
      },
      "package": "app.aloemate",
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "AloeMate needs access to your photos to analyse plant images.",
          "cameraPermission": "AloeMate needs camera access to capture plant photos."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "updates": {
      "enabled": false
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
