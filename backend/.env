# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=AloeMate Disease Detection API
APP_VERSION=1.0.0
DEBUG=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins; use * to allow all during development
ALLOWED_ORIGINS=["*"]

# ── Model directory ───────────────────────────────────────────────────────────
# Relative to backend/ root (default: ml_models/)
MODEL_DIR=ml_models

# ── Thresholds ────────────────────────────────────────────────────────────────
# Minimum unhealthy probability to proceed past Stage A
UNHEALTHY_THRESHOLD=0.55
# Minimum confidence for Stage B / C to name a class (below → "uncertain")
MIN_CONFIDENCE=0.40

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10
